# Mapbox GL JS Public Token
# Obtenha seu token público em: https://account.mapbox.com/
# Recomendado: configure restrições de URL (ex.: https://luscanascimento.github.io/pride-muay-thai/* e http://localhost:*) no painel do Mapbox.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Supabase (Project URL e chave pública / anon)
# NUNCA insira a chave service_role ou secret key no frontend!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

